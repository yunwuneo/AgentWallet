{
  "name": "agentwallet",
  "version": "0.2.0",
  "private": true,
  "description": "Virtual wallets for role-play characters, exposed over MCP",
  "type": "module",
  "bin": {
    "agentwallet-admin": "dist/cli/admin.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "pnpm --filter agentwallet-web dev",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && pnpm --filter agentwallet-web build",
    "typecheck": "tsc --noEmit && pnpm --filter agentwallet-web typecheck",
    "test": "vitest run",
    "admin": "tsx src/cli/admin.ts",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "drizzle-orm": "0.45.3",
    "hono": "^4.13.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
